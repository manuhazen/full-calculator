WEB_PORT=5173
API_PORT=8080
# Keep the internal listener at :8080 with the supplied Compose/proxy/health configuration.
API_ADDR=:8080
# Keep SQLite under /data to preserve it in the named Docker volume.
DATABASE_PATH=/data/calculator.db
API_PROXY_TARGET=http://api:8080
# Vite polling supports Windows/WSL bind mounts; Air polling is configured separately.
WATCH_POLLING=true
FRONTEND_ORIGIN=http://localhost:5173
# Same-origin Vite/Nginx proxy requests need no CORS. Enable only for intentional direct API access.
ENABLE_CORS=false
