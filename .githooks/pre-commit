#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    root=$(cygpath -m "$root")
    export MSYS_NO_PATHCONV=1
    ;;
esac

author=$(git config user.name || printf 'Calculator Workspace')
email=$(git config user.email || printf 'calculator@example.invalid')
image=calculator-workspace-formatter

# BuildKit reuses the dependency layer. No host Node.js is required.
docker build --quiet -f "$root/tools/format/Dockerfile" -t "$image" "$root" >/dev/null
docker run --rm --init \
  --mount "type=bind,source=$root,target=/workspace" \
  --env "GIT_AUTHOR_NAME=$author" \
  --env "GIT_AUTHOR_EMAIL=$email" \
  --env "GIT_COMMITTER_NAME=$author" \
  --env "GIT_COMMITTER_EMAIL=$email" \
  "$image" lint-staged --config lint-staged.config.mjs
